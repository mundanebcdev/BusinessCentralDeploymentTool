# Normalize line endings on commit, check out native line endings.
* text=auto

*.cs text eol=crlf diff=csharp
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.slnx text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf

*.md text
*.json text
*.yml text
*.yaml text

*.app binary
*.zip binary
*.png binary
*.pfx binary
*.snk binary
*.nupkg binary
